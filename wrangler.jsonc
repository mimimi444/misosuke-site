{
	"compatibility_date": "2026-05-23",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "misosuke-site",
	// 本番は gmail 側アカウント。別アカウントへの誤デプロイを防ぐため固定する
	"account_id": "c6a3018a20d7abab33bb8e9ebfee20b6",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "misosuke-db",
			"database_id": "e4698c77-5191-4894-abd6-4afd912aea85",
			"migrations_dir": "drizzle/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "misosuke-images"
		}
	],
	// Bluesky 投稿前の画像リサイズに使う
	"images": {
		"binding": "IMAGES"
	}
}