---
// タグページ: トップと同じ構成で、作品一覧と雑誌をそのタグの作品に絞る
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeLayout from '../../components/HomeLayout.astro';
import { getDb } from '../../db/client';
import { tags } from '../../db/schema';
import { eq } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { tagSlug } from '../../lib/tags';
import { loadRailPage } from '../../lib/rail';
import { RAIL_PAGE_SIZE } from '../api/rail';

const db = getDb(env.DB);
// URL の表記ゆれ（全角英数字など）も同じタグとして扱う
const slug = tagSlug(Astro.params.slug ?? '');
const [tag] = await db.select().from(tags).where(eq(tags.slug, slug));
if (!tag) return Astro.redirect('/');

const rail = await loadRailPage(db, { tagSlug: slug, limit: RAIL_PAGE_SIZE });
---

<BaseLayout title={`#${tag.name}`}>
  <HomeLayout
    items={rail.items}
    nextCursor={rail.nextCursor}
    heading={`#${tag.name}`}
    tag={tag.slug}
  />
</BaseLayout>
