---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../db/client';
import { images, imageTags, tags } from '../../db/schema';
import { eq, desc, inArray, sql } from 'drizzle-orm';
import { r2Url } from '../../lib/r2url';
import { env } from 'cloudflare:workers';

const { slug } = Astro.params;

let tagName = slug ?? '';
let imageRows: (typeof images.$inferSelect & { tagList: string | null })[] = [];

try {
  const db = getDb(env.DB);

  const [tag] = await db.select().from(tags).where(eq(tags.slug, slug!));
  if (!tag) return Astro.redirect('/');
  tagName = tag.name;

  // 対象タグの画像IDを取得
  const taggedImageIds = await db
    .select({ imageId: imageTags.imageId })
    .from(imageTags)
    .where(eq(imageTags.tagId, tag.id));

  if (taggedImageIds.length > 0) {
    const ids = taggedImageIds.map(r => r.imageId);
    const rows = await db
      .select({
        id: images.id,
        title: images.title,
        description: images.description,
        r2Key: images.r2Key,
        width: images.width,
        height: images.height,
        createdAt: images.createdAt,
        tagList: sql<string>`group_concat(${tags.name}, ',')`,
      })
      .from(images)
      .leftJoin(imageTags, eq(imageTags.imageId, images.id))
      .leftJoin(tags, eq(tags.id, imageTags.tagId))
      .where(inArray(images.id, ids))
      .groupBy(images.id)
      .orderBy(desc(images.createdAt));

    imageRows = rows as typeof imageRows;
  }
} catch { }

function parseTagList(tagList: string | null): string[] {
  if (!tagList) return [];
  return tagList.split(',').filter(Boolean);
}
---

<BaseLayout title={`#${tagName}`}>


  <div class="tag-content">
    {imageRows.length === 0 ? (
      <div style="padding:4rem 0; text-align:center; color:var(--text-muted)">
        このタグの画像はありません。
      </div>
    ) : (
      <>
        <div class="image-grid">
          {imageRows.map((img, i) => {
            const tagList = parseTagList(img.tagList);
            return (
              <div class="image-card animate-in" style={`animation-delay:${i * 0.03}s`}>
                <img src={r2Url(img.r2Key)} alt={img.title ?? ''} loading={i < 6 ? 'eager' : 'lazy'} />
                <div class="image-card-overlay">
                  {img.title && <span class="image-card-title">{img.title}</span>}
                  {tagList.length > 0 && (
                    <div class="image-card-tags">
                      {tagList.map(t => (
                        <a href={`/tags/${t.toLowerCase().replace(/\s+/g, '-').replace(/[^\w-]/g, '')}`} class="tag-pill">{t}</a>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            );
          })}
        </div>

      </>
    )}
  </div>
</BaseLayout>

<style>
  .tag-content { padding: var(--gap) clamp(1.5rem, 5vw, 3rem) 3rem; }

  .back-link {
    display: inline-block;
    margin-bottom: 0.75rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--accent); }

  .tag-prefix { color: var(--accent); margin-right: 0.1em; }

</style>

