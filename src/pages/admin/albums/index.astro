---
import { adminHref } from '../../../lib/adminSession';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../db/client';
import { albums, albumImages } from '../../../db/schema';
import { eq, desc, sql } from 'drizzle-orm';
import { r2Url } from '../../../lib/r2url';
import { env } from 'cloudflare:workers';

type AlbumRow = typeof albums.$inferSelect & { imageCount: number; coverKey: string | null };

let albumRows: AlbumRow[] = [];

try {
  const db = getDb(env.DB);
  const rows = await db
    .select({
      id: albums.id,
      title: albums.title,
      slug: albums.slug,
      description: albums.description,
      coverImageId: albums.coverImageId,
      createdAt: albums.createdAt,
      imageCount: sql<number>`count(${albumImages.imageId})`,
      coverKey: sql<string | null>`(
        SELECT r2_key FROM images
        WHERE id = COALESCE(${albums.coverImageId},
          (SELECT image_id FROM album_images WHERE album_id = ${albums.id} ORDER BY sort_order LIMIT 1)
        ) LIMIT 1
      )`,
    })
    .from(albums)
    .leftJoin(albumImages, eq(albumImages.albumId, albums.id))
    .groupBy(albums.id)
    .orderBy(desc(albums.createdAt));

  albumRows = rows as AlbumRow[];
} catch { }
---

<AdminLayout title="アルバム管理">
  <div class="albums-header">
    <h2 class="admin-section-title">アルバム管理</h2>
    <a href={adminHref('/albums/new')} class="btn btn-primary">＋ 新しいアルバム</a>
  </div>

  {albumRows.length === 0 ? (
    <div class="empty-state">
      <p>アルバムがありません。</p>
      <a href={adminHref('/albums/new')} class="btn btn-primary" style="margin-top:1rem">作成する</a>
    </div>
  ) : (
    <div class="album-list">
      {albumRows.map(album => (
        <div class="album-row">
          <div class="album-row-thumb">
            {album.coverKey
              ? <img src={r2Url(album.coverKey)} alt={album.title} loading="lazy" />
              : <div class="thumb-placeholder" />
            }
          </div>
          <div class="album-row-info">
            <h3 class="album-row-title">{album.title}</h3>
            {album.description && <p class="album-row-desc">{album.description}</p>}
            <div class="album-row-meta">
              <span>{album.imageCount} 枚</span>
              <span>/{album.slug}</span>
              <span>{new Date(album.createdAt).toLocaleDateString('ja-JP')}</span>
            </div>
          </div>
          <div class="album-row-actions">
            <a href={`/albums/${album.slug}`} class="btn btn-ghost btn-sm" target="_blank">表示</a>
            <a href={adminHref(`/albums/edit/${album.id}`)} class="btn btn-ghost btn-sm">編集</a>
            <button
              type="button"
              class="btn btn-danger btn-sm delete-btn"
              data-id={album.id}
            >削除</button>
          </div>
        </div>
      ))}
    </div>
  )}
</AdminLayout>

<style>
  .albums-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }
  .admin-section-title { margin-bottom: 0; border-bottom: none; }

  .empty-state { padding: 3rem 0; color: var(--text-muted); }

  .album-list { display: flex; flex-direction: column; gap: 0.5rem; }

  .album-row {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    gap: 1rem;
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 0.875rem;
  }

  .album-row-thumb {
    width: 72px;
    height: 72px;
    overflow: hidden;
    border-radius: 2px;
    background: var(--surface-2);
    flex-shrink: 0;
  }

  .album-row-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .thumb-placeholder { width: 100%; height: 100%; background: var(--surface-2); }

  .album-row-title {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text);
    letter-spacing: 0.04em;
  }

  .album-row-desc {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-top: 0.2rem;
  }

  .album-row-meta {
    display: flex;
    gap: 1rem;
    margin-top: 0.375rem;
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .album-row-actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .btn-sm { padding: 0.3rem 0.75rem; font-size: 0.75rem; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('このアルバムを削除しますか？（画像本体は削除されません）')) return;
      const id = btn.dataset.id!;
      const res = await fetch('/_actions/deleteAlbum', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id }),
      });
      if (res.ok) {
        btn.closest('.album-row')?.remove();
      } else {
        alert('削除に失敗しました');
      }
    });
  });
</script>
