---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../db/client';
import { images, imageTags, tags } from '../../../db/schema';
import { eq, desc, sql, inArray } from 'drizzle-orm';
import { r2Url } from '../../../lib/r2url';
import { actions } from 'astro:actions';
import { env } from 'cloudflare:workers';

// ワンクリックアルバム化: URLクエリからプリセット画像IDを取得
const presetImageIds = (Astro.url.searchParams.get('images') ?? '')
  .split(',')
  .filter(Boolean);

type ImageRow = typeof images.$inferSelect & { tagList: string | null };

let allImages: ImageRow[] = [];

try {
  const db = getDb(env.DB);
  const rows = await db
    .select({
      id: images.id,
      title: images.title,
      description: images.description,
      r2Key: images.r2Key,
      width: images.width,
      height: images.height,
      createdAt: images.createdAt,
      tagList: sql<string>`group_concat(${tags.name}, ',')`,
    })
    .from(images)
    .leftJoin(imageTags, eq(imageTags.imageId, images.id))
    .leftJoin(tags, eq(tags.id, imageTags.tagId))
    .groupBy(images.id)
    .orderBy(desc(images.createdAt));
  allImages = rows as ImageRow[];
} catch { }

// フォーム処理
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const title = fd.get('title')?.toString() ?? '';
  const description = fd.get('description')?.toString() ?? '';
  const imageIds = fd.get('imageIds')?.toString() ?? '';
  const coverImageId = fd.get('coverImageId')?.toString() ?? undefined;

  const { data, error } = await Astro.callAction(actions.createAlbum, {
    title,
    description,
    imageIds,
    coverImageId,
  });

  if (data) {
    return Astro.redirect(`/albums/${data.slug}`);
  }
}

function parseTagList(tagList: string | null): string[] {
  if (!tagList) return [];
  return tagList.split(',').filter(Boolean);
}
---

<AdminLayout title="アルバムを作成">
  <div class="new-album-header">
    <a href="/admin/albums" class="back-link">← アルバム一覧</a>
    <h2 class="admin-section-title">アルバムを作成</h2>
    {presetImageIds.length > 0 && (
      <p class="preset-notice">{presetImageIds.length} 枚の画像がプリセットされています</p>
    )}
  </div>

  <form method="POST" class="new-album-form">
    <div class="form-row">
      <div class="form-group">
        <label for="title">タイトル <span class="required">*</span></label>
        <input type="text" id="title" name="title" required placeholder="アルバムタイトル" />
      </div>
      <div class="form-group">
        <label for="description">説明（任意）</label>
        <input type="text" id="description" name="description" placeholder="このアルバムについて" />
      </div>
    </div>

    <input type="hidden" name="imageIds" id="imageIdsInput" value={presetImageIds.join(',')} />
    <input type="hidden" name="coverImageId" id="coverImageIdInput" />

    <div class="image-picker-section">
      <div class="picker-header">
        <h3 class="picker-title">画像を選択</h3>
        <span class="selected-count" id="selectedCount">
          {presetImageIds.length > 0 ? `${presetImageIds.length} 枚選択中` : '0 枚選択中'}
        </span>
      </div>

      <div class="image-picker-grid">
        {allImages.map(img => {
          const isPreset = presetImageIds.includes(img.id);
          const tagList = parseTagList(img.tagList);
          return (
            <label
              class:list={['picker-card', { selected: isPreset }]}
              data-id={img.id}
            >
              <input
                type="checkbox"
                class="picker-check"
                value={img.id}
                checked={isPreset}
                hidden
              />
              <div class="picker-thumb">
                <img src={r2Url(img.r2Key)} alt={img.title ?? ''} loading="lazy" />
                <div class="picker-check-mark">✓</div>
              </div>
              {img.title && <span class="picker-label">{img.title}</span>}
            </label>
          );
        })}
      </div>
    </div>

    <div class="form-submit">
      <button type="submit" class="btn btn-primary">アルバムを作成</button>
      <a href="/admin/albums" class="btn btn-ghost">キャンセル</a>
    </div>
  </form>
</AdminLayout>

<style>
  .new-album-header { margin-bottom: 1.5rem; }

  .back-link {
    display: inline-block;
    margin-bottom: 0.75rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--accent); }

  .admin-section-title { border-bottom: none; margin-bottom: 0.5rem; }

  .preset-notice {
    font-size: 0.8rem;
    color: var(--accent);
    letter-spacing: 0.04em;
    padding: 0.375rem 0.75rem;
    background: rgba(212, 168, 160, 0.1);
    border-left: 2px solid var(--accent);
    border-radius: 0 2px 2px 0;
    display: inline-block;
  }

  .required { color: var(--accent); }

  .new-album-form { max-width: 900px; }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .image-picker-section {
    border: 1px solid var(--border);
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .picker-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1rem;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .picker-title {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text);
    letter-spacing: 0.04em;
  }

  .selected-count {
    font-size: 0.8rem;
    color: var(--accent);
    letter-spacing: 0.04em;
  }

  .image-picker-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: 0.5rem;
    padding: 1rem;
    max-height: 420px;
    overflow-y: auto;
    background: var(--bg);
  }

  .picker-card {
    position: relative;
    cursor: pointer;
    border-radius: 2px;
    overflow: hidden;
    border: 2px solid transparent;
    transition: border-color 0.15s;
  }

  .picker-card.selected { border-color: var(--accent); }

  .picker-thumb {
    position: relative;
    aspect-ratio: 1;
  }

  .picker-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: filter 0.2s;
  }

  .picker-card.selected .picker-thumb img { filter: brightness(0.7); }

  .picker-check-mark {
    position: absolute;
    top: 0.3rem;
    right: 0.3rem;
    width: 20px;
    height: 20px;
    background: var(--accent);
    color: var(--bg);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
    opacity: 0;
    transition: opacity 0.15s;
  }

  .picker-card.selected .picker-check-mark { opacity: 1; }

  .picker-label {
    display: block;
    padding: 0.25rem 0.375rem;
    font-size: 0.65rem;
    color: var(--text-muted);
    background: var(--surface);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .form-submit {
    display: flex;
    gap: 0.75rem;
  }
</style>

<script>
  const imageIdsInput = document.getElementById('imageIdsInput') as HTMLInputElement;
  const countEl = document.getElementById('selectedCount')!;
  const cards = document.querySelectorAll<HTMLElement>('.picker-card');

  function getSelected(): string[] {
    return [...document.querySelectorAll<HTMLInputElement>('.picker-check:checked')]
      .map(c => c.value);
  }

  function updateHiddenInputs() {
    const selected = getSelected();
    imageIdsInput.value = selected.join(',');
    countEl.textContent = `${selected.length} 枚選択中`;
  }

  cards.forEach(card => {
    card.addEventListener('click', () => {
      const check = card.querySelector<HTMLInputElement>('.picker-check')!;
      check.checked = !check.checked;
      card.classList.toggle('selected', check.checked);
      updateHiddenInputs();
    });
  });
</script>
