---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../db/client';
import { albums, albumImages, images, imageTags, tags } from '../../db/schema';
import { eq, asc, sql } from 'drizzle-orm';
import { r2Url } from '../../lib/r2url';
import { env } from 'cloudflare:workers';

const { slug } = Astro.params;

type ImageRow = typeof images.$inferSelect & { tagList: string | null };

let album: typeof albums.$inferSelect | null = null;
let imageRows: ImageRow[] = [];

try {
  const db = getDb(env.DB);

  const [found] = await db.select().from(albums).where(eq(albums.slug, slug!));
  if (!found) return Astro.redirect('/albums');
  album = found;

  const rows = await db
    .select({
      id: images.id,
      title: images.title,
      description: images.description,
      r2Key: images.r2Key,
      width: images.width,
      height: images.height,
      createdAt: images.createdAt,
      tagList: sql<string>`group_concat(${tags.name}, ',')`,
    })
    .from(albumImages)
    .innerJoin(images, eq(images.id, albumImages.imageId))
    .leftJoin(imageTags, eq(imageTags.imageId, images.id))
    .leftJoin(tags, eq(tags.id, imageTags.tagId))
    .where(eq(albumImages.albumId, found.id))
    .groupBy(images.id)
    .orderBy(asc(albumImages.sortOrder));

  imageRows = rows as ImageRow[];
} catch { }

function parseTagList(tagList: string | null): string[] {
  if (!tagList) return [];
  return tagList.split(',').filter(Boolean);
}

const pagesJson = JSON.stringify(
  imageRows.map(img => ({ id: String(img.id), src: r2Url(img.r2Key) }))
);
---

<BaseLayout title={album?.title ?? 'アルバム'}>
  {album ? (
    <>
      <div class="album-content">
        <div class="album-header-row">
          <h1 class="album-title">{album.title}</h1>
          {imageRows.length > 0 && (
            <button id="openViewerBtn" class="btn btn-primary">読む</button>
          )}
        </div>

        {imageRows.length === 0 ? (
          <div class="empty-state" style="padding:4rem 0; text-align:center; color:var(--text-muted)">
            このアルバムにはまだ画像がありません。
          </div>
        ) : (
          <div class="image-grid">
            {imageRows.map((img, i) => {
              const tagList = parseTagList(img.tagList);
              return (
                <div class="image-card animate-in" style={`animation-delay:${i * 0.03}s`}>
                  <img src={r2Url(img.r2Key)} alt={img.title ?? ''} loading={i < 6 ? 'eager' : 'lazy'} />
                  <div class="image-card-overlay">
                    {img.title && <span class="image-card-title">{img.title}</span>}
                    {tagList.length > 0 && (
                      <div class="image-card-tags">
                        {tagList.map(t => (
                          <a href={`/tags/${t.toLowerCase().replace(/\s+/g, '-').replace(/[^\w-]/g, '')}`} class="tag-pill">{t}</a>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </div>

      <div
        id="viewerOverlay"
        class="viewer-overlay"
        data-album-slug={album.slug}
        data-album-title={album.title ?? ''}
        data-pages={pagesJson}
        hidden
      >
        <button id="closeViewerBtn" class="btn btn-ghost viewer-close" aria-label="閉じる">✕</button>
        <div id="viewerContainer" class="viewer-container"></div>
      </div>
    </>
  ) : (
    <div style="padding:4rem; text-align:center; color:var(--text-muted)">
      アルバムが見つかりません。
    </div>
  )}
</BaseLayout>

<style>
  .album-content {
    padding: var(--gap) clamp(1.5rem, 5vw, 3rem) 3rem;
  }

  .album-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    gap: 1rem;
  }

  .album-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
  }

  .viewer-overlay {
    position: fixed;
    inset: 0;
    background: #000;
    z-index: 1000;
    display: flex;
    flex-direction: column;
  }

  .viewer-overlay[hidden] { display: none; }

  .viewer-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 1001;
  }

  .viewer-container {
    flex: 1;
    overflow: hidden;
  }
</style>

<script>
  import { createMangaViewer } from '@yui540/comimi';

  const overlay = document.getElementById('viewerOverlay') as HTMLDivElement | null;
  const openBtn = document.getElementById('openViewerBtn');
  const closeBtn = document.getElementById('closeViewerBtn');
  const container = document.getElementById('viewerContainer');

  if (overlay && openBtn && closeBtn && container) {
    const albumSlug = overlay.dataset.albumSlug ?? '';
    const albumTitle = overlay.dataset.albumTitle ?? '';
    const pages: Array<{ id: string; src: string }> = JSON.parse(overlay.dataset.pages ?? '[]');

    let viewer: ReturnType<typeof createMangaViewer> | null = null;

    openBtn.addEventListener('click', () => {
      overlay.hidden = false;
      viewer = createMangaViewer(container, {
        manga: {
          id: albumSlug,
          title: albumTitle,
          pages: pages.map(p => ({
            id: p.id,
            type: 'image' as const,
            src: p.src,
          })),
        },
        locale: 'ja',
        settings: {
          readingDirection: 'rtl',
          pageTurnMode: 'single',
          layoutMode: 'inline',
          backgroundColor: 'black',
        },
        storage: { enabled: true },
      });
    });

    function closeViewer() {
      if (viewer) { viewer.destroy(); viewer = null; }
      overlay!.hidden = true;
    }

    closeBtn.addEventListener('click', closeViewer);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !overlay!.hidden) closeViewer();
    });
  }
</script>
