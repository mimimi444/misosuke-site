---
// アルバムの詳細: トップと同じ構成に、作品詳細を開いた状態で返す（?page=n でそのページから）
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeLayout from '../../components/HomeLayout.astro';
import { getDb } from '../../db/client';
import { albums } from '../../db/schema';
import { sql } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { albumHref, albumIdPrefixFromSlug } from '../../lib/albumSlug';
import { parseDetailPath } from '../../lib/detail';
import { loadDetail } from '../../lib/detailData';
import { loadHome } from '../../lib/homeData';

const slug = Astro.params.slug ?? '';
const db = getDb(env.DB);
const parsed = parseDetailPath(Astro.url.pathname, Astro.url.search);
const page = parsed?.kind === 'album' ? parsed.page : null;
const detail = await loadDetail(db, { kind: 'album', slug, page });

if (!detail) {
  // 古い形式の slug（日本語が消えていた頃のもの）なら、末尾の ID から今のアルバムを探して移動する
  const prefix = albumIdPrefixFromSlug(slug);
  const candidates = prefix
    ? await db.select().from(albums).where(sql`substr(${albums.id}, 1, 6) = ${prefix}`).limit(2)
    : [];
  if (candidates.length === 1) {
    return Astro.redirect(`${albumHref(candidates[0]!.slug)}${page ? `?page=${page}` : ''}`, 301);
  }
  Astro.response.status = 404;
}

const home = detail && detail.pages.length > 0 ? await loadHome(db) : null;
const description = detail?.description ?? detail?.pages[detail.startIndex]?.description ?? '';
---

<BaseLayout title={detail?.title ?? '見つかりません'} description={description.slice(0, 120)}>
  {home && detail ? (
    <HomeLayout items={home.items} nextCursor={home.nextCursor} detail={detail} />
  ) : (
    <div class="empty detail-missing">
      <p>{detail ? 'このアルバムにはまだ画像がありません。' : 'アルバムが見つかりません。'}</p>
      <a href="/albums" class="btn btn-ghost">← アルバム一覧</a>
    </div>
  )}
</BaseLayout>

<style>
  .detail-missing { margin: 3rem clamp(1rem, 3vw, 2.5rem); }
</style>
