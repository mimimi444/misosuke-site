---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../db/client';
import { albums, albumImages } from '../../db/schema';
import { eq, desc, sql } from 'drizzle-orm';
import { r2Url } from '../../lib/r2url';
import { env } from 'cloudflare:workers';

type AlbumRow = typeof albums.$inferSelect & {
  imageCount: number;
  coverKey: string | null;
};

let albumRows: AlbumRow[] = [];

try {
  const db = getDb(env.DB);
  const rows = await db
    .select({
      id: albums.id,
      title: albums.title,
      slug: albums.slug,
      description: albums.description,
      coverImageId: albums.coverImageId,
      createdAt: albums.createdAt,
      imageCount: sql<number>`count(${albumImages.imageId})`,
      coverKey: sql<string | null>`(
        SELECT r2_key FROM images
        WHERE id = COALESCE(${albums.coverImageId},
          (SELECT image_id FROM album_images WHERE album_id = ${albums.id} ORDER BY sort_order LIMIT 1)
        ) LIMIT 1
      )`,
    })
    .from(albums)
    .leftJoin(albumImages, eq(albumImages.albumId, albums.id))
    .groupBy(albums.id)
    .orderBy(desc(albums.createdAt));

  albumRows = rows as AlbumRow[];
} catch { }
---

<BaseLayout title="アルバム">
  <div class="albums-container">
    {albumRows.length === 0 ? (
      <div class="empty-state">
        <p>アルバムがありません。</p>
      </div>
    ) : (
      <div class="albums-grid">
        {albumRows.map((album, i) => (
          <div class="album-card animate-in" style={`animation-delay:${i * 0.05}s`}>
            <div class="album-cover">
              {album.coverKey
                ? <img src={r2Url(album.coverKey)} alt={album.title} loading="lazy" />
                : <div class="album-cover-placeholder">No Image</div>
              }
              <div class="album-count">{album.imageCount} 枚</div>
            </div>
            <div class="album-info">
              <h2 class="album-title">{album.title}</h2>
              {album.description && <p class="album-desc">{album.description}</p>}
              {album.imageCount > 0 && (
                <button
                  class="btn btn-primary open-viewer-btn"
                  data-slug={album.slug}
                  data-title={album.title}
                >開く</button>
              )}
            </div>
          </div>
        ))}
      </div>
    )}
  </div>

  <div id="viewerOverlay" class="viewer-overlay" hidden>
    <button id="closeViewerBtn" class="btn btn-ghost viewer-close" aria-label="閉じる">✕</button>
    <div class="viewer-layout">
      <nav class="viewer-thumbs" id="viewerThumbs" aria-label="ページ一覧"></nav>
      <div id="viewerContainer" class="viewer-container"></div>
    </div>
  </div>
</BaseLayout>

<style>
  .albums-container {
    padding: var(--gap) clamp(1.5rem, 5vw, 3rem) 3rem;
  }

  .empty-state {
    padding: 4rem 0;
    text-align: center;
    color: var(--text-muted);
  }

  .albums-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }

  .album-card {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .album-cover {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    border-radius: 2px;
    background: var(--surface);
  }

  .album-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .album-cover-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .album-count {
    position: absolute;
    bottom: 0.625rem;
    right: 0.625rem;
    background: rgba(12, 11, 10, 0.75);
    color: var(--text-muted);
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    letter-spacing: 0.04em;
  }

  .album-info {
    padding: 0 0.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .album-title {
    font-family: var(--font-jp);
    font-size: 1rem;
    font-weight: 500;
    color: var(--text);
    letter-spacing: 0.04em;
  }

  .album-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .open-viewer-btn {
    align-self: flex-start;
    margin-top: 0.25rem;
    font-size: 0.8rem;
    padding: 0.4rem 1rem;
  }

  /* ビューワーオーバーレイ */
  .viewer-overlay {
    position: fixed;
    inset: 0;
    background: #000;
    z-index: 1000;
    display: flex;
    flex-direction: column;
  }

  .viewer-overlay[hidden] { display: none; }

  .viewer-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 1001;
  }

  .viewer-layout {
    flex: 1;
    display: flex;
    overflow: hidden;
  }

  .viewer-thumbs {
    width: 88px;
    overflow-y: auto;
    background: #0a0a0a;
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    flex-shrink: 0;
  }

  .viewer-thumb {
    display: block;
    width: 100%;
    padding: 0;
    background: none;
    border: 2px solid transparent;
    border-radius: 2px;
    cursor: pointer;
    transition: border-color 0.15s;
  }

  .viewer-thumb.active { border-color: var(--accent); }

  .viewer-thumb img {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    display: block;
    border-radius: 1px;
  }

  .viewer-container {
    flex: 1;
    overflow: hidden;
  }
</style>

<script>
  import { createMangaViewer } from '@yui540/comimi';

  type PageData = { id: string; src: string };
  type AlbumData = { id: string; title: string; slug: string; pages: PageData[] };

  const overlay = document.getElementById('viewerOverlay') as HTMLDivElement | null;
  const closeBtn = document.getElementById('closeViewerBtn');
  const thumbsEl = document.getElementById('viewerThumbs') as HTMLElement | null;
  const container = document.getElementById('viewerContainer') as HTMLDivElement | null;

  if (!overlay || !closeBtn || !thumbsEl || !container) throw new Error('viewer elements missing');

  let viewer: ReturnType<typeof createMangaViewer> | null = null;

  function updateActiveThumb(pageIndex: number) {
    thumbsEl!.querySelectorAll<HTMLElement>('.viewer-thumb').forEach((el, i) => {
      el.classList.toggle('active', i === pageIndex);
    });
    const active = thumbsEl!.querySelector<HTMLElement>(`.viewer-thumb[data-index="${pageIndex}"]`);
    active?.scrollIntoView({ block: 'nearest' });
  }

  async function openAlbum(slug: string, title: string) {
    const res = await fetch(`/api/albums/${encodeURIComponent(slug)}`);
    if (!res.ok) return;
    const data: AlbumData = await res.json();
    if (data.pages.length === 0) return;

    // サムネパネルを構築
    const thumbBtns = data.pages.map((page, i) => {
      const btn = document.createElement('button');
      btn.className = 'viewer-thumb';
      btn.dataset.index = String(i);
      const img = document.createElement('img');
      img.src = page.src;
      img.alt = `ページ ${i + 1}`;
      img.loading = 'lazy';
      btn.appendChild(img);
      btn.addEventListener('click', () => viewer?.goToPage(i));
      return btn;
    });
    thumbsEl!.replaceChildren(...thumbBtns);

    overlay!.hidden = false;

    viewer = createMangaViewer(container!, {
      manga: {
        id: data.slug,
        title: data.title,
        pages: data.pages.map(p => ({ id: p.id, type: 'image' as const, src: p.src })),
      },
      locale: 'ja',
      settings: {
        readingDirection: 'rtl',
        pageTurnMode: 'single',
        layoutMode: 'inline',
        backgroundColor: 'black',
      },
      storage: { enabled: true },
      events: {
        pageChange: ({ pageIndex }: { pageIndex: number }) => updateActiveThumb(pageIndex),
      },
    });
  }

  function closeViewer() {
    if (viewer) { viewer.destroy(); viewer = null; }
    overlay!.hidden = true;
    thumbsEl!.replaceChildren();
  }

  document.querySelectorAll<HTMLButtonElement>('.open-viewer-btn').forEach(btn => {
    btn.addEventListener('click', () => openAlbum(btn.dataset.slug!, btn.dataset.title!));
  });

  closeBtn.addEventListener('click', closeViewer);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !overlay!.hidden) closeViewer();
  });
</script>
