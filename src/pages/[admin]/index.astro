---
import { adminHref } from '../../lib/adminSession';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../db/client';
import { images, albums, tags } from '../../db/schema';
import { desc, sql } from 'drizzle-orm';
import { r2Url } from '../../lib/r2url';
import { env } from 'cloudflare:workers';

let imageCount = 0;
let albumCount = 0;
let tagCount = 0;
let recentImages: (typeof images.$inferSelect)[] = [];

try {
  const db = getDb(env.DB);
  const [ic] = await db.select({ count: sql<number>`count(*)` }).from(images);
  const [ac] = await db.select({ count: sql<number>`count(*)` }).from(albums);
  const [tc] = await db.select({ count: sql<number>`count(*)` }).from(tags);
  imageCount = ic.count;
  albumCount = ac.count;
  tagCount = tc.count;
  recentImages = await db.select().from(images).orderBy(desc(images.createdAt)).limit(6);
} catch { }
---

<AdminLayout title="ダッシュボード">
  <h2 class="admin-section-title">ダッシュボード</h2>

  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-value">{imageCount}</div>
      <div class="stat-label">画像</div>
    </div>
    <div class="stat-card">
      <div class="stat-value">{albumCount}</div>
      <div class="stat-label">アルバム</div>
    </div>
    <div class="stat-card">
      <div class="stat-value">{tagCount}</div>
      <div class="stat-label">タグ</div>
    </div>
  </div>

  <div class="quick-actions">
    <a href={adminHref('/upload')} class="btn btn-primary">＋ 画像をアップロード</a>
    <a href={adminHref('/albums/new')} class="btn btn-ghost">＋ アルバムを作成</a>
  </div>

  {recentImages.length > 0 && (
    <section class="recent-section">
      <h3 class="recent-title">最近の投稿</h3>
      <div class="recent-grid">
        {recentImages.map(img => (
          <div class="recent-thumb">
            <img src={r2Url(img.r2Key)} alt={img.title ?? ''} loading="lazy" />
            {img.title && <span class="recent-label">{img.title}</span>}
          </div>
        ))}
      </div>
    </section>
  )}
</AdminLayout>

<style>
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
    max-width: 500px;
  }

  .stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 1.25rem;
    text-align: center;
  }

  .stat-value {
    font-family: var(--font-serif);
    font-size: 2rem;
    color: var(--text);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.06em;
    margin-top: 0.375rem;
  }

  .quick-actions {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .recent-section { margin-top: 1rem; }

  .recent-title {
    font-size: 0.8rem;
    color: var(--text-muted);
    letter-spacing: 0.06em;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .recent-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.5rem;
  }

  .recent-thumb {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 2px;
    background: var(--surface);
  }

  .recent-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .recent-label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.25rem 0.375rem;
    font-size: 0.65rem;
    background: rgba(12,11,10,0.8);
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
