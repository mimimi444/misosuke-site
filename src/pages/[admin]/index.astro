---
import { adminHref } from '../../lib/adminSession';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../db/client';
import { images, albums, tags } from '../../db/schema';
import { desc, isNull, sql } from 'drizzle-orm';
import { r2Url } from '../../lib/r2url';
import { env } from 'cloudflare:workers';

let imageCount = 0;
let albumCount = 0;
let tagCount = 0;
let missingThumbs = 0;
let recentImages: (typeof images.$inferSelect)[] = [];

try {
  const db = getDb(env.DB);
  const [ic] = await db.select({ count: sql<number>`count(*)` }).from(images);
  const [ac] = await db.select({ count: sql<number>`count(*)` }).from(albums);
  const [tc] = await db.select({ count: sql<number>`count(*)` }).from(tags);
  imageCount = ic.count;
  albumCount = ac.count;
  tagCount = tc.count;
  const [mt] = await db.select({ count: sql<number>`count(*)` }).from(images).where(isNull(images.thumbR2Key));
  missingThumbs = mt.count;
  recentImages = await db.select().from(images).orderBy(desc(images.createdAt)).limit(6);
} catch { }
---

<AdminLayout title="ダッシュボード">
  <h2 class="page-title">ダッシュボード <span class="hud-label">OVERVIEW</span></h2>

  <div class="stats-grid">
    <div class="panel stat">
      <span class="hud-label">IMAGES</span>
      <span class="mono-number stat-value">{imageCount}</span>
      <span class="stat-label">画像</span>
    </div>
    <div class="panel stat">
      <span class="hud-label">ALBUMS</span>
      <span class="mono-number stat-value">{albumCount}</span>
      <span class="stat-label">アルバム</span>
    </div>
    <div class="panel stat">
      <span class="hud-label">TAGS</span>
      <span class="mono-number stat-value">{tagCount}</span>
      <span class="stat-label">タグ</span>
    </div>
  </div>

  <div class="row quick-actions">
    <a href={adminHref('/upload')} class="btn btn-primary">＋ 画像をアップロード</a>
    <a href={adminHref('/albums/new')} class="btn">＋ アルバムを作成</a>
  </div>

  {missingThumbs > 0 && (
    <section class="panel thumbs-panel" data-endpoint={adminHref('/maintenance/thumbnails')}>
      <p class="hud-label">MAINTENANCE</p>
      <p>作品一覧用のサムネイルがまだ無い画像が <strong class="mono-number" id="thumbsRemaining">{missingThumbs}</strong> 件あります。</p>
      <div class="row">
        <button type="button" class="btn btn-primary btn-sm" id="thumbsRun">サムネイルを作成</button>
        <span class="hud-label" id="thumbsStatus" aria-live="polite"></span>
      </div>
    </section>
  )}

  {recentImages.length > 0 && (
    <section>
      <h3 class="hud-label recent-title">RECENT / 最近の投稿</h3>
      <div class="recent-grid">
        {recentImages.map(img => (
          <figure class="card recent-thumb">
            <img src={r2Url(img.r2Key)} alt={img.title ?? ''} loading="lazy" />
            <figcaption class="recent-label">{img.title || '無題'}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}
</AdminLayout>

<style>
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
    max-width: 540px;
  }
  .stat { display: flex; flex-direction: column; gap: 0.25rem; }
  .stat-value { font-size: 2.25rem; line-height: 1.1; }
  .stat-label { font-size: 0.75rem; color: var(--ink-muted); }

  .quick-actions { margin-bottom: 2.5rem; }
  .thumbs-panel { display: flex; flex-direction: column; gap: 0.5rem; max-width: 540px; margin-bottom: 2rem; }

  .recent-title { margin-bottom: 0.75rem; }
  .recent-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.75rem;
  }
  .recent-thumb { margin: 0; }
  .recent-thumb img { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .recent-label {
    padding: 0.35rem 0.5rem;
    font-size: 0.75rem;
    color: var(--ink-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<script>
  // サムネイルが無い画像がなくなるまで、少しずつ作成を呼び出す
  const panel = document.querySelector<HTMLElement>('.thumbs-panel');
  const run = document.getElementById('thumbsRun') as HTMLButtonElement | null;
  const remainingEl = document.getElementById('thumbsRemaining');
  const statusEl = document.getElementById('thumbsStatus');
  run?.addEventListener('click', async () => {
    run.disabled = true;
    try {
      for (;;) {
        statusEl!.textContent = 'RUNNING…';
        const res = await fetch(panel!.dataset.endpoint!, { method: 'POST' });
        if (!res.ok) throw new Error(String(res.status));
        const { remaining } = (await res.json()) as { processed: number; remaining: number };
        remainingEl!.textContent = String(remaining);
        if (remaining === 0) break;
      }
      statusEl!.textContent = 'DONE';
    } catch (e) {
      statusEl!.textContent = `ERROR ${e instanceof Error ? e.message : ''}`;
      run.disabled = false;
    }
  });
</script>
