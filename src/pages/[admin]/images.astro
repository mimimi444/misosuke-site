---
import { adminHref } from '../../lib/adminSession';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../db/client';
import { images, imageTags, tags } from '../../db/schema';
import { eq, desc, sql } from 'drizzle-orm';
import { r2Url } from '../../lib/r2url';
import { env } from 'cloudflare:workers';

const PAGE_SIZE = 30;
const page = Number(Astro.url.searchParams.get('page') ?? '1');
const offset = (page - 1) * PAGE_SIZE;

type ImageRow = typeof images.$inferSelect & { tagList: string | null };

let imageRows: ImageRow[] = [];
let totalCount = 0;

try {
  const db = getDb(env.DB);
  const rows = await db
    .select({
      id: images.id,
      title: images.title,
      description: images.description,
      r2Key: images.r2Key,
      width: images.width,
      height: images.height,
      createdAt: images.createdAt,
      tagList: sql<string>`group_concat(${tags.name}, ',')`,
    })
    .from(images)
    .leftJoin(imageTags, eq(imageTags.imageId, images.id))
    .leftJoin(tags, eq(tags.id, imageTags.tagId))
    .groupBy(images.id)
    .orderBy(desc(images.createdAt))
    .limit(PAGE_SIZE)
    .offset(offset);

  imageRows = rows as ImageRow[];

  const [{ count }] = await db.select({ count: sql<number>`count(*)` }).from(images);
  totalCount = count;
} catch { }

const totalPages = Math.ceil(totalCount / PAGE_SIZE);

function parseTagList(tagList: string | null): string[] {
  if (!tagList) return [];
  return tagList.split(',').filter(Boolean);
}
---

<AdminLayout title="画像管理">
  <div class="images-header">
    <h2 class="page-title">画像管理 <span class="mono-number count">{totalCount}</span> <span class="hud-label">IMAGES</span></h2>
    <a href={adminHref('/upload')} class="btn btn-primary">＋ アップロード</a>
  </div>

  <div class="images-grid">
    {imageRows.map(img => {
      const tagList = parseTagList(img.tagList);
      return (
        <div class="card image-manage-card" data-id={img.id}>
          <div class="image-manage-thumb">
            <img src={r2Url(img.r2Key)} alt={img.title ?? ''} loading="lazy" />
          </div>
          <div class="image-manage-body">
            <form class="edit-form" data-id={img.id}>
              <input
                type="text"
                class="edit-title"
                placeholder="タイトル"
                value={img.title ?? ''}
              />
              <input
                type="text"
                class="edit-tags"
                placeholder="タグ（カンマ区切り）"
                value={tagList.join(', ')}
              />
              <div class="edit-actions">
                <button type="submit" class="btn btn-sm">保存</button>
                <button type="button" class="btn btn-danger btn-sm delete-btn" data-id={img.id}>削除</button>
                <a href={adminHref(`/images/${img.id}/download`)} class="btn btn-ghost btn-sm" download>元画像DL</a>
              </div>
            </form>
            <div class="hud-label image-meta">{new Date(img.createdAt).toLocaleDateString('ja-JP')}</div>
          </div>
        </div>
      );
    })}
  </div>

  {totalPages > 1 && (
    <nav class="row pager" aria-label="ページ送り">
      {page > 1 && <a href={adminHref(`/images?page=${page - 1}`)} class="btn btn-sm">← 前</a>}
      <span class="hud-label">{page} / {totalPages}</span>
      {page < totalPages && <a href={adminHref(`/images?page=${page + 1}`)} class="btn btn-sm">次 →</a>}
    </nav>
  )}
</AdminLayout>

<style>
  .images-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  .images-header .page-title { margin-bottom: 0; }
  .count { font-size: 1rem; color: var(--ink-muted); }

  .images-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }

  .image-manage-card { display: flex; flex-direction: column; }
  .image-manage-thumb { aspect-ratio: 1; overflow: hidden; }
  .image-manage-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
  .image-manage-card:hover .image-manage-thumb img { transform: scale(1.03); }

  .image-manage-body { padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .edit-form { display: flex; flex-direction: column; gap: 0.5rem; }
  .edit-form input { font-size: 0.8rem; padding: 0.4rem 0.55rem; }
  .edit-actions { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .image-meta { padding-top: 0.25rem; }

  .pager { justify-content: center; padding: 2rem 0; }

  .status-toast {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    background: var(--panel-solid);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md);
    padding: 0.625rem 1rem;
    font-size: 0.8rem;
    color: var(--ink);
    box-shadow: var(--shadow);
    transform: translateY(60px);
    opacity: 0;
    transition: transform 0.25s, opacity 0.25s;
    z-index: 500;
  }
  .status-toast.show { transform: translateY(0); opacity: 1; }
</style>

<div id="statusToast" class="status-toast"></div>

<script>
  function showToast(msg: string) {
    const t = document.getElementById('statusToast')!;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2500);
  }

  document.querySelectorAll<HTMLFormElement>('.edit-form').forEach(form => {
    form.addEventListener('submit', async e => {
      e.preventDefault();
      const id = form.dataset.id!;
      const title = (form.querySelector('.edit-title') as HTMLInputElement).value;
      const tagNames = (form.querySelector('.edit-tags') as HTMLInputElement).value;

      const res = await fetch('/_actions/updateImage', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, title, tagNames }),
      });

      showToast(res.ok ? '保存しました' : '保存に失敗しました');
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('この画像を削除しますか？')) return;
      const id = btn.dataset.id!;

      const res = await fetch('/_actions/deleteImage', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id }),
      });

      if (res.ok) {
        btn.closest('.image-manage-card')?.remove();
        showToast('削除しました');
      } else {
        showToast('削除に失敗しました');
      }
    });
  });
</script>
