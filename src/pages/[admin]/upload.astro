---
import { adminHref } from '../../lib/adminSession';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../db/client';
import { tags } from '../../db/schema';
import { asc } from 'drizzle-orm';
import UploadForm from '../../components/UploadForm';
import { env } from 'cloudflare:workers';

let tagSuggestions: string[] = [];
try {
  const db = getDb(env.DB);
  const allTags = await db.select().from(tags).orderBy(asc(tags.name));
  tagSuggestions = allTags.map(t => t.name);
} catch { }
---

<AdminLayout title="アップロード">
  <h2 class="admin-section-title">画像アップロード</h2>
  <UploadForm tagSuggestions={tagSuggestions} siteUrl={Astro.site?.href ?? ''} imagesHref={adminHref('/images')} client:load />
</AdminLayout>

<style>
  :global(.upload-area) { max-width: 860px; }
  :global(.upload-message) { margin-bottom: 1rem; color: var(--accent); font-weight: 600; font-size: 0.875rem; }

  :global(.drop-zone) {
    border: 2px dashed var(--border);
    border-radius: 4px;
    padding: 3rem 2rem;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }
  :global(.drop-zone:hover),
  :global(.drop-zone.drag-over) {
    border-color: var(--accent-dim);
    background: rgba(212, 168, 160, 0.04);
  }

  :global(.drop-icon) { font-size: 2.5rem; color: var(--text-muted); margin-bottom: 0.75rem; }
  :global(.drop-text) { font-size: 0.9rem; color: var(--text); letter-spacing: 0.04em; }
  :global(.drop-sub) { font-size: 0.75rem; color: var(--text-muted); margin-top: 0.375rem; }

  :global(.preview-list) { margin-top: 1.5rem; display: flex; flex-direction: column; gap: 1rem; }

  :global(.preview-item) {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 0.875rem;
  }

  :global(.preview-thumb) { position: relative; aspect-ratio: 1; overflow: hidden; border-radius: 2px; }
  :global(.preview-thumb img) { width: 100%; height: 100%; object-fit: cover; }

  :global(.preview-remove) {
    position: absolute;
    top: 0.25rem;
    right: 0.25rem;
    width: 22px;
    height: 22px;
    background: rgba(12,11,10,0.8);
    border: 1px solid var(--border);
    color: var(--text-muted);
    border-radius: 2px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
  }
  :global(.preview-remove:hover) { color: #c97070; }

  :global(.preview-fields) { display: flex; flex-direction: column; gap: 0.75rem; }
  :global(.form-group) { display: flex; flex-direction: column; gap: 0.5rem; }

  :global(.bluesky-settings) {
    border: none;
    border-top: 1px dashed var(--border);
    margin: 0;
    padding: 0.75rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  :global(.bluesky-options) { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; padding-left: 1.5rem; }
  :global(.check) { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; cursor: pointer; }
  :global(.check:has(input:disabled)) { opacity: 0.5; cursor: default; }
  :global(.bluesky-settings textarea:disabled) { opacity: 0.5; }
  :global(.post-count) { font-size: 0.75rem; color: var(--text-muted); text-align: right; }
  :global(.post-count.over) { color: var(--accent); font-weight: 600; }
  :global(.post-edited-note) { font-size: 0.75rem; color: var(--text-muted); }
  :global(.btn-link) {
    background: none; border: none; padding: 0; margin-left: 0.5rem;
    color: var(--accent-dim); text-decoration: underline; cursor: pointer; font: inherit;
  }

  :global(.submit-row) { display: flex; gap: 0.75rem; margin-top: 1.25rem; }

  :global(.progress-area) { margin-top: 2rem; max-width: 500px; }
  :global(.progress-bar) { height: 4px; background: var(--surface-2); border-radius: 2px; overflow: hidden; margin-bottom: 0.75rem; }
  :global(.progress-fill) { height: 100%; background: var(--accent); border-radius: 2px; transition: width 0.3s ease; }
  :global(.progress-text) { font-size: 0.875rem; color: var(--text-muted); letter-spacing: 0.04em; }

  :global(.btn) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.25rem;
    font-family: var(--font-jp);
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    border-radius: 2px;
    cursor: pointer;
    transition: all 0.2s;
    border: none;
    text-decoration: none;
  }
  :global(.btn-primary) { background: var(--accent); color: var(--bg); font-weight: 600; }
  :global(.btn-primary:hover) { background: #e0bab3; }
  :global(.btn-ghost) { background: transparent; color: var(--text-muted); border: 1px solid var(--border); }
  :global(.btn-ghost:hover) { color: var(--text); border-color: var(--text-muted); }
</style>
