---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../db/client';
import { tags } from '../../db/schema';
import { asc } from 'drizzle-orm';
import UploadForm from '../../components/UploadForm';
import { env } from 'cloudflare:workers';

let tagSuggestions: string[] = [];
try {
  const db = getDb(env.DB);
  const allTags = await db.select().from(tags).orderBy(asc(tags.name));
  tagSuggestions = allTags.map(t => t.name);
} catch { }
---

<AdminLayout title="アップロード">
  <h2 class="page-title">画像アップロード <span class="hud-label">UPLOAD</span></h2>
  <UploadForm tagSuggestions={tagSuggestions} siteUrl={Astro.site?.href ?? ''} client:load />
</AdminLayout>

<style>
  /* UploadForm（React）の中身。色は変数、ボタン・入力欄・チップは共通の部品を使う */
  :global(.upload-area) { max-width: 860px; }
  :global(.upload-message) { margin-bottom: 1rem; color: var(--accent); font-weight: 600; font-size: 0.875rem; }

  :global(.drop-zone) {
    border: 1px dashed var(--line-strong);
    border-radius: var(--r-md);
    background: var(--panel);
    padding: 3rem 2rem;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }
  :global(.drop-zone:hover),
  :global(.drop-zone.drag-over) { border-color: var(--accent); background: var(--accent-soft); }
  :global(.drop-zone:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }

  :global(.drop-icon) { font-family: var(--font-mono); font-size: 2rem; color: var(--ink-muted); margin-bottom: 0.5rem; }
  :global(.drop-text) { font-size: 0.9rem; color: var(--ink); }
  :global(.drop-sub) { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.08em; color: var(--ink-muted); margin-top: 0.375rem; }

  :global(.preview-list) { margin-top: 1.5rem; display: flex; flex-direction: column; gap: 1rem; }

  :global(.preview-item) {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1rem;
    background: var(--panel-solid);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 1rem;
  }
  @media (max-width: 560px) { :global(.preview-item) { grid-template-columns: 1fr; } }

  :global(.preview-thumb) { position: relative; aspect-ratio: 1; overflow: hidden; border-radius: var(--r-sm); }
  :global(.preview-thumb img) { width: 100%; height: 100%; object-fit: cover; }

  :global(.preview-remove) {
    position: absolute;
    top: 0.3rem;
    right: 0.3rem;
    width: 24px;
    height: 24px;
    background: var(--panel-solid);
    border: 1px solid var(--line-strong);
    color: var(--ink-muted);
    border-radius: var(--r-pill);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
  }
  :global(.preview-remove:hover) { color: var(--danger); border-color: var(--danger); }

  :global(.preview-fields) { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; }

  :global(.bluesky-settings) {
    border: none;
    border-top: 1px dashed var(--line-strong);
    margin: 0;
    padding: 0.75rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  :global(.bluesky-options) { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; padding-left: 1.5rem; }
  :global(.check) { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: var(--ink); cursor: pointer; }
  :global(.check:has(input:disabled)) { opacity: 0.5; cursor: default; }
  :global(.bluesky-settings textarea:disabled) { opacity: 0.5; }
  :global(.post-count) { font-family: var(--font-mono); font-size: 0.7rem; color: var(--ink-muted); text-align: right; }
  :global(.post-count.over) { color: var(--accent); font-weight: 600; }
  :global(.post-edited-note) { font-size: 0.75rem; color: var(--ink-muted); }
  :global(.btn-link) {
    background: none; border: none; padding: 0; margin-left: 0.5rem;
    color: var(--accent); text-decoration: underline; cursor: pointer; font: inherit;
  }

  :global(.submit-row) { display: flex; gap: 0.75rem; margin-top: 1.25rem; }

  :global(.progress-area) { margin-top: 2rem; max-width: 500px; }
  :global(.progress-bar) { height: 4px; background: var(--line); border-radius: var(--r-pill); overflow: hidden; margin-bottom: 0.75rem; }
  :global(.progress-fill) { height: 100%; background: var(--accent); transition: width 0.3s ease; }
  :global(.progress-text) { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-muted); letter-spacing: 0.06em; }
</style>
