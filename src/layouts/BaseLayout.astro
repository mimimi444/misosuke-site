---
import '../styles/global.css';
import { isLoggedIn } from '../lib/adminSession';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'JJJ', description = '' } = Astro.props;

// ログイン中だけ、管理画面へのリンクを出す（キャッシュさせない設定は src/middleware.ts で付ける）
const loggedIn = await isLoggedIn(Astro.cookies);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    {description && <meta name="description" content={description} />}
    <title>{title === 'JJJ' ? title : `${title} — JJJ`}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@100..900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="grain"></div>

    <SiteHeader variant="public" loggedIn={loggedIn} />

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <span>JUNK JOURNAL JOURNEY — 二次創作個人サイト</span>
    </footer>
  </body>
</html>

<style is:global>
  body { display: flex; flex-direction: column; }
  main { flex: 1; }

  /* 画像グリッド（フィード・タグページ。計画 2 で作り替える） */
  .image-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--gap);
  }

  .image-card {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-md);
    background: var(--panel-solid);
    aspect-ratio: 1;
    cursor: pointer;
    border: 1px solid var(--line);
  }

  .image-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), filter 0.4s;
  }

  .image-card:hover img { transform: scale(1.04); filter: brightness(0.8); }

  /* カード全体を押せるようにする透明なボタン。タグのリンクはその上で押せる */
  .image-open {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: transparent;
    cursor: zoom-in;
  }
  .image-open:focus-visible { outline: 3px solid var(--accent); outline-offset: -3px; }
  .image-card:has(.image-open:focus-visible) .image-card-overlay { opacity: 1; }

  .image-card-overlay {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    inset: 0;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: var(--scrim);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .image-card:hover .image-card-overlay { opacity: 1; }

  .image-card-title { font-size: 0.875rem; font-weight: 600; color: var(--overlay-ink); letter-spacing: 0.04em; }

  .image-card-tags {
    pointer-events: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.375rem;
  }

  /* ページネーション */
  .pagination { display: flex; align-items: center; justify-content: center; gap: 0.75rem; padding: 2.5rem 0; }
  .pagination a, .pagination span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    text-decoration: none;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-sm);
  }
  .pagination a:hover { color: var(--accent); border-color: var(--accent); }
  .pagination .current { color: var(--accent); border-color: var(--accent); }
</style>
