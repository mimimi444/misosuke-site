---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = '管理画面' } = Astro.props;
import { adminHref } from '../lib/adminSession';
import SiteHeader from '../components/SiteHeader.astro';
import { env } from 'cloudflare:workers';
import { getDb } from '../db/client';
import { loadTheme } from '../lib/themeStore';
const theme = await loadTheme(getDb(env.DB));
const pathname = Astro.url.pathname.replace(/\/$/, '');
const isAt = (p: string) => pathname === adminHref(p);
const isUnderPath = (p: string) => isAt(p) || pathname.startsWith(adminHref(p) + '/');
---

<!doctype html>
<html lang="ja" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — JJJ管理</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@100..900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="grain"></div>

    <SiteHeader variant="admin" />

    <div class="admin-layout">
      <div class="admin-content">
        <slot />
      </div>
      
      <aside class="admin-sidebar">
        <a href={adminHref('')} class:list={['admin-sidebar-link', { active: isAt('') }]}>ダッシュボード</a>
        <a href={adminHref('/upload')} class:list={['admin-sidebar-link', { active: isAt('/upload') }]}>アップロード</a>
        <a href={adminHref('/images')} class:list={['admin-sidebar-link', { active: isAt('/images') }]}>画像管理</a>
        <a href={adminHref('/albums')} class:list={['admin-sidebar-link', { active: isUnderPath('/albums') }]}>アルバム管理</a>
        <a href={adminHref('/free-page')} class:list={['admin-sidebar-link', { active: isAt('/free-page') }]}>フリーページ</a>
        <a href={adminHref('/theme')} class:list={['admin-sidebar-link', { active: isAt('/theme') }]}>テーマカラー</a>
        <form method="post" action={adminHref('/logout')} class="admin-logout">
          <button type="submit" class="btn btn-ghost btn-sm">ログアウト</button>
        </form>
      </aside>
    </div>
  </body>
</html>

<style is:global>
  .admin-logout { margin-top: 1.5rem; padding: 0 0.75rem; }
</style>
