---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = '管理画面' } = Astro.props;
import { adminHref } from '../lib/adminSession';
const pathname = Astro.url.pathname.replace(/\/$/, '');
const isAt = (p: string) => pathname === adminHref(p);
const isUnderPath = (p: string) => isAt(p) || pathname.startsWith(adminHref(p) + '/');
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — JJJ管理</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@100..900&family=Palette+Mosaic&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="grain"></div>

    <header class="site-header">
      <a href="/" class="site-logo">
        <span class="logo-main">JJJ</span>
        <span class="logo-sub">ジャンク<br class="sp_only">ジャーナル<br class="sp_only">ジャーニー</span>
      </a>
      <span class="admin-badge">管理画面</span>
      <nav style="margin-left: auto;">
        <a href="/" class="nav-link">← サイトへ戻る</a>
      </nav>
    </header>

    <div class="admin-layout">
      <div class="admin-content">
        <slot />
      </div>
      
      <aside class="admin-sidebar">
        <a href={adminHref('')} class:list={['admin-sidebar-link', { active: isAt('') }]}>ダッシュボード</a>
        <a href={adminHref('/upload')} class:list={['admin-sidebar-link', { active: isAt('/upload') }]}>アップロード</a>
        <a href={adminHref('/images')} class:list={['admin-sidebar-link', { active: isAt('/images') }]}>画像管理</a>
        <a href={adminHref('/albums')} class:list={['admin-sidebar-link', { active: isUnderPath('/albums') }]}>アルバム管理</a>
        <form method="post" action={adminHref('/logout')} class="admin-logout">
          <button type="submit" class="admin-sidebar-link admin-logout-btn">ログアウト</button>
        </form>
      </aside>
    </div>
  </body>
</html>

<style is:global>
  .admin-logout { margin-top: 1.5rem; }
  .admin-logout-btn { background: none; border: none; cursor: pointer; font: inherit; text-align: left; width: 100%; }
  .admin-badge {
    font-size: 0.7rem;
    color: var(--accent);
    border: 1px solid rgba(255, 87, 20, 0.35);
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    letter-spacing: 0.06em;
    margin-left: 0.75rem;
  }
</style>
