---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = '管理画面' } = Astro.props;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — JJJ管理</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@100..900&family=Palette+Mosaic&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="grain"></div>

    <header class="site-header">
      <a href="/" class="site-logo">
        <span class="logo-main">JJJ</span>
        <span class="logo-sub">ジャンクジャーナルジャーニー</span>
      </a>
      <span class="admin-badge">管理画面</span>
      <nav style="margin-left: auto;">
        <a href="/" class="nav-link">← サイトへ戻る</a>
      </nav>
    </header>

    <div class="admin-layout">
      <aside class="admin-sidebar">
        <a href="/admin" class:list={['admin-sidebar-link', { active: pathname === '/admin' }]}>ダッシュボード</a>
        <a href="/admin/upload" class:list={['admin-sidebar-link', { active: pathname === '/admin/upload' }]}>アップロード</a>
        <a href="/admin/images" class:list={['admin-sidebar-link', { active: pathname === '/admin/images' }]}>画像管理</a>
        <a href="/admin/albums" class:list={['admin-sidebar-link', { active: pathname.startsWith('/admin/albums') }]}>アルバム管理</a>
      </aside>

      <div class="admin-content">
        <slot />
      </div>
    </div>
  </body>
</html>

<style is:global>
  .admin-badge {
    font-size: 0.7rem;
    color: var(--accent);
    border: 1px solid rgba(255, 87, 20, 0.35);
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    letter-spacing: 0.06em;
    margin-left: 0.75rem;
  }
</style>
