---
interface Props {
  title?: string;
  activeSection?: string;
}
const { title = '管理画面', activeSection } = Astro.props;
const pathname = Astro.url.pathname;
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — みそすけ管理</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Shippori+Mincho:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="grain"></div>

    <header class="site-header">
      <a href="/" class="site-logo">みそすけ</a>
      <span class="admin-badge">管理画面</span>
      <nav class="site-nav">
        <a href="/" class="nav-link">← サイトへ戻る</a>
      </nav>
    </header>

    <div class="admin-layout">
      <aside class="admin-sidebar">
        <a href="/admin" class:list={['admin-sidebar-link', { active: pathname === '/admin' }]}>ダッシュボード</a>
        <a href="/admin/upload" class:list={['admin-sidebar-link', { active: pathname === '/admin/upload' }]}>アップロード</a>
        <a href="/admin/images" class:list={['admin-sidebar-link', { active: pathname === '/admin/images' }]}>画像管理</a>
        <a href="/admin/albums" class:list={['admin-sidebar-link', { active: pathname.startsWith('/admin/albums') }]}>アルバム管理</a>
      </aside>

      <div class="admin-content">
        <slot />
      </div>
    </div>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #0c0b0a;
    --surface: #161412;
    --surface-2: #1f1c19;
    --border: #2a2520;
    --text: #ede8e0;
    --text-muted: #8a8278;
    --accent: #d4a8a0;
    --accent-dim: #9a6e68;
    --font-serif: 'EB Garamond', 'Shippori Mincho', serif;
    --font-jp: 'Shippori Mincho', 'EB Garamond', serif;
  }

  html { font-size: 16px; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-jp);
    line-height: 1.7;
    min-height: 100vh;
  }

  .grain {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 999;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 128px 128px;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem clamp(1.5rem, 5vw, 3rem);
    border-bottom: 1px solid var(--border);
    background: rgba(12, 11, 10, 0.9);
    backdrop-filter: blur(12px);
  }

  .site-logo {
    font-family: var(--font-jp);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--text);
    text-decoration: none;
    letter-spacing: 0.08em;
  }

  .admin-badge {
    font-size: 0.7rem;
    color: var(--accent-dim);
    border: 1px solid var(--border);
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    letter-spacing: 0.06em;
  }

  .site-nav { margin-left: auto; }

  .nav-link {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-link:hover { color: var(--text); }

  .admin-layout {
    display: grid;
    grid-template-columns: 200px 1fr;
    min-height: calc(100vh - 65px);
  }

  .admin-sidebar {
    border-right: 1px solid var(--border);
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    position: sticky;
    top: 65px;
    height: calc(100vh - 65px);
    overflow-y: auto;
  }

  .admin-sidebar-link {
    display: block;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    border-radius: 2px;
    letter-spacing: 0.04em;
    transition: color 0.2s, background 0.2s;
  }
  .admin-sidebar-link:hover { color: var(--text); background: var(--surface-2); }
  .admin-sidebar-link.active { color: var(--accent); background: var(--surface-2); }

  .admin-content { padding: 2rem clamp(1.5rem, 3vw, 2.5rem); }

  .admin-section-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--text);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  a { color: inherit; }
  img { display: block; max-width: 100%; }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.25rem;
    font-family: var(--font-jp);
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    border-radius: 2px;
    cursor: pointer;
    transition: all 0.2s;
    border: none;
    text-decoration: none;
  }
  .btn-primary { background: var(--accent); color: var(--bg); font-weight: 600; }
  .btn-primary:hover { background: #e0bab3; }
  .btn-ghost { background: transparent; color: var(--text-muted); border: 1px solid var(--border); }
  .btn-ghost:hover { color: var(--text); border-color: var(--text-muted); }
  .btn-danger { background: transparent; color: #c97070; border: 1px solid #5a3030; }
  .btn-danger:hover { background: rgba(201, 112, 112, 0.15); }

  .form-group { display: flex; flex-direction: column; gap: 0.5rem; }

  label { font-size: 0.8rem; color: var(--text-muted); letter-spacing: 0.06em; }

  input[type="text"],
  input[type="email"],
  textarea,
  select {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 2px;
    color: var(--text);
    font-family: var(--font-jp);
    font-size: 0.9rem;
    padding: 0.625rem 0.875rem;
    width: 100%;
    outline: none;
    transition: border-color 0.2s;
  }
  input:focus, textarea:focus, select:focus { border-color: var(--accent-dim); }
  textarea { resize: vertical; min-height: 80px; }
</style>
