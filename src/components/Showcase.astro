---
// トップとタグページの「見せる」ページめくり。
// JavaScript 前は固定内容（fallback）の最初の見開きを平面で出し、three.js の準備ができたらキャンバスに切り替える。
import type { Showcase } from '../lib/showcase';

interface Props {
  showcase: Showcase | null;
}
const { showcase: fallback } = Astro.props;
// 最初の見開き: 左は表紙の内側（無地）、右に 1 枚目の絵
const firstPage = fallback?.pages[0];
// JavaScript 前・WebGL なしのときのリンク先（最初の見開きの 1 ページ目）
const first = fallback?.pages[0];
const fallbackHref = first?.href ?? '#';
---

<section class="showcase" aria-label="作品の雑誌">
  {fallback ? (
    <>
      <div class="showcase-flat" aria-hidden="false">
        <span class="showcase-flat-blank" aria-hidden="true"></span>
        {firstPage?.src && <img src={firstPage.src} alt={firstPage.title} />}
      </div>
      <canvas class="showcase-canvas" hidden aria-label={`${fallback.title} のページがめくれる様子`}></canvas>
      <a class="showcase-hit" href={fallbackHref} aria-label={`${fallback.title} を見る`}></a>

      <div class="showcase-hud showcase-now panel">
        <p class="hud-label">NOW OPEN</p>
        <p class="showcase-title" data-role="title">{fallback.title}</p>
        <p class="hud-label" data-role="count">{fallback.pages.length} PAGES</p>
      </div>
      <p class="showcase-hud showcase-turn hud-label" data-role="turn">AUTO TURN ・ 01 / {String(fallback.pages.length).padStart(2, '0')}</p>

      <!-- 3D の雑誌の準備ができるまでの読み込み画面（JavaScript が動くときだけ出す） -->
      <div class="showcase-loading" data-role="loading" aria-hidden="true">
        <div class="showcase-loading-inner">
          <p class="hud-label">LOADING</p>
          <p class="mono-number showcase-loading-value" data-role="loading-value">0%</p>
          <span class="showcase-loading-bar"><span data-role="loading-bar"></span></span>
        </div>
      </div>

      <script type="application/json" data-role="showcase" set:html={JSON.stringify(fallback).replace(/</g, '\\u003c')}></script>
    </>
  ) : (
    <div class="empty showcase-empty">まだ作品がありません。</div>
  )}
</section>

<style is:global>
  /* 横スワイプはページめくりに使うので、ブラウザには縦のスクロールとズームだけを任せる */
  .showcase { position: relative; min-height: 0; min-width: 0; overflow: hidden; touch-action: pan-y pinch-zoom; }
  .showcase-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .showcase-canvas[hidden] { display: none; }

  /* JavaScript 前・WebGL なしの平面表示: 見開きを少し傾けて置く */
  .showcase-flat {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2px;
    padding: 8% 10%;
  }
  .showcase-flat img {
    max-width: 42%;
    max-height: 80%;
    object-fit: contain;
    background: var(--sheet);
    padding: 1.2rem;
    box-shadow: var(--shadow-strong);
  }
  .showcase-flat-blank { width: 42%; aspect-ratio: 3 / 4; max-height: 80%; background: var(--cover-inner); box-shadow: var(--shadow-strong); }
  .showcase[data-mode="3d"] .showcase-flat { display: none; }

  .showcase-hit { position: absolute; inset: 0; z-index: 1; }
  .showcase-hit:focus-visible { outline: 3px solid var(--accent); outline-offset: -3px; }

  /* 計器風パネル（トップでは絵に重なってよい） */
  .showcase-hud { position: absolute; z-index: 2; pointer-events: none; margin: 0; }
  .showcase-now { top: 1rem; right: 1rem; min-width: 180px; max-width: 46%; }
  .showcase-title { font-weight: 700; overflow-wrap: anywhere; }
  .showcase-turn { left: 1rem; bottom: 1rem; }

  .showcase-empty { margin: 2rem; }

  /* 読み込み画面: JavaScript が動くときだけ出し、準備ができたら薄くして消す。3D が使えなければ出さない */
  .showcase-loading {
    display: none;
    position: absolute;
    inset: 0;
    z-index: 6;
    place-items: center;
    background: var(--paper);
    transition: opacity 0.5s ease;
  }
  .js .showcase-loading { display: grid; }
  .showcase[data-loaded] .showcase-loading { opacity: 0; pointer-events: none; }
  .showcase[data-mode="flat"] .showcase-loading,
  .showcase[data-loading-done] .showcase-loading { display: none; }
  .showcase-loading-inner { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; }
  .showcase-loading-value { font-size: 2.4rem; line-height: 1; letter-spacing: 0.04em; }
  .showcase-loading-bar { display: block; width: 160px; height: 2px; background: var(--line); overflow: hidden; }
  .showcase-loading-bar span { display: block; height: 100%; width: 0; background: var(--accent); }
  @media (prefers-reduced-motion: reduce) { .showcase-loading { transition: none; } }
</style>

<script>
  import { initShowcases } from '../lib/showcaseClient';
  initShowcases();
</script>
