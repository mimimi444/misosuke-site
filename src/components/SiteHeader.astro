---
// 公開サイトと管理画面で共通のヘッダー。
// 左: オレンジの JJJ ＋サイト名、右: ナビ（公開）または「サイトへ戻る」（管理画面）
import { adminHref } from '../lib/adminSession';

interface Props {
  variant: 'public' | 'admin';
  loggedIn?: boolean;
}
const { variant, loggedIn = false } = Astro.props;
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <a href="/" class="site-logo" aria-label="ジャンクジャーナルジャーニー トップへ">
    <span class="site-logo-mark">JJJ</span>
    <span class="site-logo-name">ジャンクジャーナルジャーニー</span>
  </a>
  {variant === 'admin' && <span class="hud-label site-header-badge">ADMIN</span>}

  <nav class="site-nav" aria-label="サイト内">
    {variant === 'public' ? (
      <>
        <a href="/" class:list={['nav-link', { active: pathname === '/' }]}>FEED</a>
        <a href="/albums" class:list={['nav-link', { active: pathname.startsWith('/albums') }]}>ALBUMS</a>
        {loggedIn && <a href={adminHref('')} class="nav-link nav-admin" rel="nofollow">管理画面</a>}
      </>
    ) : (
      <a href="/" class="nav-link">← サイトへ戻る</a>
    )}
  </nav>
</header>
