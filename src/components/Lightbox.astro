---
// 画像 1 枚を全画面で表示するライトボックス。背景は半透明の黒。
// 開くのは src/lib/lightbox.ts の openLightbox()。背景・✕・Esc で閉じる。
---

<div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="画像の拡大表示" hidden>
  <button type="button" id="lightboxClose" class="lightbox-close" aria-label="閉じる">✕</button>
  <figure class="lightbox-figure">
    <img id="lightboxImg" class="lightbox-img" alt="" />
    <figcaption id="lightboxCaption" class="lightbox-caption"></figcaption>
  </figure>
</div>

<style is:global>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.82);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(0.75rem, 3vw, 2.5rem);
    animation: lightbox-in 0.2s ease-out;
    cursor: zoom-out;
  }
  .lightbox[hidden] { display: none; }

  @keyframes lightbox-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .lightbox-figure {
    margin: 0;
    max-width: 100%;
    max-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .lightbox-img {
    max-width: 100%;
    max-height: calc(100vh - 6rem);
    max-height: calc(100dvh - 6rem);
    object-fit: contain;
    border-radius: 2px;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5);
    cursor: default;
  }

  .lightbox-caption {
    color: #fff;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-align: center;
  }
  .lightbox-caption:empty { display: none; }

  .lightbox-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    font-size: 1.1rem;
    cursor: pointer;
  }
  .lightbox-close:hover,
  .lightbox-close:focus-visible { background: rgba(255, 255, 255, 0.3); }
</style>

<script>
  import { initLightbox } from '../lib/lightbox';
  initLightbox();
</script>
