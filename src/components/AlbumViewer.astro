---
// アルバムを comimi ビューワーで全画面表示するオーバーレイ。
// ページ側からは `[data-open-album]` 属性を持つ要素のクリック、または
// `openAlbumViewer(slug, startImageId?)`（src/lib/albumViewer.ts）で開く。
---

<div id="viewerOverlay" class="viewer-overlay" role="dialog" aria-modal="true" aria-label="アルバムビューワー" hidden>
  <button id="closeViewerBtn" class="btn btn-ghost viewer-close" aria-label="閉じる">✕</button>
  <div class="viewer-layout">
    <nav class="viewer-thumbs" id="viewerThumbs" aria-label="ページ一覧"></nav>
    <div id="viewerContainer" class="viewer-container"></div>
  </div>
</div>

<style is:global>
  .viewer-overlay {
    position: fixed;
    inset: 0;
    background: #000;
    z-index: 1000;
    display: flex;
    flex-direction: column;
  }

  .viewer-overlay[hidden] { display: none; }

  .viewer-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 1001;
  }

  .viewer-layout {
    flex: 1;
    display: flex;
    overflow: hidden;
  }

  .viewer-thumbs {
    width: 88px;
    overflow-y: auto;
    background: #0a0a0a;
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    flex-shrink: 0;
  }

  .viewer-thumb {
    display: block;
    width: 100%;
    padding: 0;
    background: none;
    border: 2px solid transparent;
    border-radius: 2px;
    cursor: pointer;
    transition: border-color 0.15s;
  }

  .viewer-thumb.active { border-color: var(--accent); }

  .viewer-thumb img {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    display: block;
    border-radius: 1px;
  }

  .viewer-container {
    flex: 1;
    overflow: hidden;
  }
</style>

<script>
  import { initAlbumViewer } from '../lib/albumViewer';
  initAlbumViewer();
</script>
