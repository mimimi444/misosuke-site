---
// トップとタグページで共通の構成: 左（スマホは上）に流れる作品一覧、残りに空中の雑誌。
import Rail from './Rail.astro';
import Showcase from './Showcase.astro';
import type { RailItem } from '../lib/rail';
import type { Showcase as ShowcaseData, ShowcaseCandidates } from '../lib/showcase';

interface Props {
  items: RailItem[];
  nextCursor: string | null;
  candidates: ShowcaseCandidates;
  fallback: ShowcaseData | null;
  /** タグページの見出し（例: #春） */
  heading?: string;
  tag?: string;
}
const { items, nextCursor, candidates, fallback, heading, tag } = Astro.props;
---

<div class="home">
  {items.length > 0 && <Rail items={items} nextCursor={nextCursor} tag={tag} />}
  <div class="home-stage">
    {heading && <h1 class="home-heading panel"><span class="hud-label">TAG</span> {heading}</h1>}
    <Showcase candidates={candidates} fallback={fallback} />
  </div>
</div>

<style is:global>
  .home {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    height: calc(100vh - var(--header-h));
    height: calc(100dvh - var(--header-h));
    border-bottom: 1px solid var(--line);
  }
  .home:not(:has(.rail)) { grid-template-columns: minmax(0, 1fr); }
  .home > .rail { border-right: 1px solid var(--line); }
  .home-stage { position: relative; display: grid; min-height: 0; min-width: 0; }
  .home-stage > .showcase { grid-area: 1 / 1; }
  .home-heading {
    grid-area: 1 / 1;
    align-self: start;
    justify-self: start;
    z-index: 3;
    margin: 1rem;
    font-size: 1.1rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  @media (max-width: 768px) {
    .home { grid-template-columns: minmax(0, 1fr); grid-template-rows: 76px minmax(0, 1fr); }
    .home:not(:has(.rail)) { grid-template-rows: minmax(0, 1fr); }
    .home > .rail { border-right: none; border-bottom: 1px solid var(--line); }
  }
</style>
